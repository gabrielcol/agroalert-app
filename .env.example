# Copy to .env and fill in. `bun run db:migrate` then `bun dev`.

# Database (SQLite for now — see README "Switching to Postgres")
DATABASE_URL="file:./dev.db"

# better-auth (required) — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# OAuth (optional — leave blank to run email/password only)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# RBAC bootstrap ONLY (optional) — comma-separated user ids granted admin
# regardless of their stored role. This is a standing privilege bypass: use it
# only to create the first admin, then CLEAR it once an admin exists. Prefer
# `bun run create-user <email> <password> admin` and leave this empty in production.
ADMIN_USER_IDS=""

# Crop / Variety Recommendation — Anthropic API (server only).
# ANTHROPIC_API_KEY is optional at boot (`bun dev` and the Playwright web server
# start without it) and required the moment a recommendation is requested: the
# wizard shows its retry screen until it is set. AI_MODEL must be a Sonnet- or
# Opus-class id; the call forces tool use, which Fable/Mythos ids reject.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"

# Client base URL (only needed if the auth server is on a different origin)
# NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Shadcn Studio (premium registry access — used by the shadcn CLI / MCP Server)
EMAIL=""
LICENSE_KEY=""
