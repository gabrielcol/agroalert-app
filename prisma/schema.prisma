// Prisma schema — SQLite for now. To move to Postgres, see README ("Switching to Postgres").
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// better-auth models — keep in sync with `bunx @better-auth/cli generate`
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  // better-auth admin plugin — RBAC + moderation (see src/lib/permissions.ts).
  // New sign-ups default to the non-privileged "pending" role until an admin
  // assigns one; the app enforces default-deny for unknown roles.
  role       String    @default("pending")
  banned     Boolean   @default(false)
  banReason  String?
  banExpires DateTime?

  // App relations
  posts     Post[]
  auditLogs AuditLog[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // better-auth admin plugin — set while an admin impersonates this user
  impersonatedBy String?

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ---------------------------------------------------------------------------
// Application models
// ---------------------------------------------------------------------------

/// Demo vertical slice: a per-user record that exercises auth → tRPC → Prisma
/// → UI end to end. Replace with your own domain models.
model Post {
  id        String   @id @default(cuid())
  title     String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("post")
}

/// Append-only audit trail of every privileged action. Never updated or
/// deleted through the app — writes only. `metadata` holds a JSON diff/payload.
model AuditLog {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  actorId      String?
  actorRole    String?
  action       String
  resourceType String
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  metadata     String?
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([resourceType, resourceId])
  @@index([actorId])
  @@map("audit_log")
}

/// Singleton system configuration (id = "singleton"): the default UI locale
/// and the site name shown in the app masthead. Extend with your own settings.
model SystemConfig {
  id            String   @id @default("singleton")
  defaultLocale String   @default("ro")
  siteName      String   @default("")
  updatedAt     DateTime @updatedAt

  @@map("system_config")
}

// ---------------------------------------------------------------------------
// AgroAlert domain — Field Profile, weather cache, recommendations
// (issue 0003; terms in CONTEXT.md, decisions in docs/adr/0003)
// ---------------------------------------------------------------------------

/// What the farmer told us about their land (CONTEXT.md "Field Profile").
/// Anonymous: no user relation, cuid ids travel in the wizard URL, kept
/// indefinitely for the hackathon.
model FieldProfile {
  id          String   @id @default(cuid())
  villageName String
  lat         Float
  lng         Float
  /// "small" | "medium" | "large" (under 5 / 5-10 / over 10 ha)
  landBucket  String
  irrigation  Boolean
  /// "cernoziom" | "lutos" | "argilos" | "nisipos" | "unknown"
  soilClass   String
  createdAt   DateTime @default(now())

  cropRecommendations CropRecommendation[]

  @@map("field_profile")
}

/// Open-Meteo cache keyed by the Field Location rounded to a 0.1° cell
/// (about one ERA5-Land grid cell). Holds only aggregated JSON — the Climate
/// Profile (refreshed monthly), Forecast and Seasonal Outlook (6-hour TTL) —
/// never raw daily series.
model WeatherCell {
  id                String    @id @default(cuid())
  latCell           Float
  lngCell           Float
  climateProfile    Json?
  climateFetchedAt  DateTime?
  forecast          Json?
  forecastFetchedAt DateTime?
  outlook           Json?
  outlookFetchedAt  DateTime?
  /// e.g. "ERA5-Land", "EC46"
  sourceDataset     String?
  /// e.g. "2016-01-01..2025-12-31"
  sourceSpan        String?

  @@unique([latCell, lngCell])
  @@map("weather_cell")
}

/// The AI's ranked Crop Recommendation for one Field Profile, stored with the
/// exact Weather Brief it was given so the answer can be replayed.
model CropRecommendation {
  id             String       @id @default(cuid())
  fieldProfileId String
  fieldProfile   FieldProfile @relation(fields: [fieldProfileId], references: [id], onDelete: Cascade)
  /// Weather Brief snapshot (Zod `weatherBriefSchema`)
  weatherBrief   Json
  /// Crop Recommendation output (Zod `cropRecommendationSchema`, validated on write)
  result         Json
  modelId        String
  createdAt      DateTime     @default(now())

  varietyRecommendations VarietyRecommendation[]

  @@index([fieldProfileId])
  @@map("crop_recommendation")
}

/// Variety Recommendation for the Crop the farmer chose from a Crop Recommendation.
model VarietyRecommendation {
  id                   String             @id @default(cuid())
  cropRecommendationId String
  cropRecommendation   CropRecommendation @relation(fields: [cropRecommendationId], references: [id], onDelete: Cascade)
  cropId               String
  /// Variety Recommendation output (Zod `varietyRecommendationSchema`, validated on write)
  result               Json
  modelId              String
  createdAt            DateTime           @default(now())

  @@index([cropRecommendationId])
  @@map("variety_recommendation")
}
